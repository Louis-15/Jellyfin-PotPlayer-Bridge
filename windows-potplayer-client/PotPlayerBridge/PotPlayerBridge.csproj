<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PotPlayerBridge</RootNamespace>
    <AssemblyName>PotPlayerBridge</AssemblyName>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Jellyfin-PotPlayer-Bridge</Company>
    <Product>PotPlayer Bridge</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 托盘/程序图标复用仓库里的 logo，不额外引入外部资源 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 单文件发布时把原生库一起打进 exe，避免用户看到一堆 dll -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 设置页 HTML 内嵌进 exe，单文件运行时也能直接取到 -->
    <EmbeddedResource Include="Web\settings.html" />
  </ItemGroup>

</Project>
