<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Jellyfin.Plugin.PotPlayerBridge.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PotPlayerBridge.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.PotPlayerBridge\Jellyfin.Plugin.PotPlayerBridge.csproj" />
    <!--
      主工程刻意不把 Jellyfin 程序集拷到输出目录（会被 Jellyfin 当插件依赖重复加载）。
      测试宿主加载插件程序集时需要这些类型，所以这里带 runtime 资产单独引用一次。
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
  </ItemGroup>

</Project>
